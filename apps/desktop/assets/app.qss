/* FCP 客户端主题（2026-11 视觉改版）。
   设计口径：中性冷灰背景 + 纯白浮起卡面，层级靠"底色 vs 卡面"的明度差建立，
   不靠描边；主色 #0e8c80 只出现在关键动作与运行中状态，别处一律灰阶。
   与 mainwindow.cpp 顶部的颜色常量同一套，改一处要同时改另一处。 */

* {
  font-family: "Segoe UI Variable Display", "Segoe UI", "Microsoft YaHei UI", "Noto Sans SC", sans-serif;
  font-size: 13px;
  color: #16212b;
}

QMainWindow, QWidget#central {
  background: #eef1f4;
}

/* ---------- 左侧导航栏 ---------- */

QWidget#rail {
  background: #ffffff;
  border: none;
  border-right: 1px solid #e3e8ec;
}

QLabel#brandName {
  font-size: 16px;
  font-weight: 700;
  letter-spacing: -0.2px;
}

QLabel#brandSub {
  font-size: 11px;
  font-weight: 500;
  color: #8b98a3;
  letter-spacing: 0.4px;
}

QPushButton#nav {
  text-align: left;
  padding-left: 12px;
  min-height: 40px;
  border: none;
  border-radius: 10px;
  background: transparent;
  color: #52616b;
  font-size: 13px;
  font-weight: 500;
}

QPushButton#nav:hover {
  background: #f2f5f7;
  color: #16212b;
}

QPushButton#nav:checked {
  background: #e3f1ee;
  color: #116b62;
  font-weight: 600;
}

QPushButton#nav:disabled {
  color: #b3bdc6;
}

/* 侧栏底部的连接状态块：轻描边、无填充，让主区成为唯一焦点。 */
QFrame[role="railFoot"] {
  background: #f7f9fa;
  border: 1px solid #e8ecef;
  border-radius: 12px;
}

/* ---------- 通用排版 ---------- */

QLabel[role="muted"] {
  color: #52616b;
  font-size: 12px;
}

QLabel[role="mutedSmall"] {
  color: #8b98a3;
  font-size: 11px;
}

QLabel[role="mono"] {
  font-family: "Cascadia Mono", "Consolas", "JetBrains Mono", monospace;
  font-size: 11px;
  color: #8b98a3;
}

QLabel[role="monoStrong"] {
  font-family: "Cascadia Mono", "Consolas", "JetBrains Mono", monospace;
  font-size: 12px;
  font-weight: 600;
  color: #52616b;
}

QLabel[role="h2"] {
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -0.2px;
}

QLabel[role="headSub"] {
  font-size: 12px;
  color: #8b98a3;
}

QLabel[role="fieldLabel"] {
  font-size: 12px;
  color: #3d4a54;
  font-weight: 600;
}

QLabel[role="fieldNote"] {
  font-size: 11px;
  color: #8b98a3;
}

QLabel[role="keyOk"] {
  font-size: 11px;
  font-weight: 500;
  color: #0e8c80;
}

QLabel[role="keyBad"] {
  font-size: 11px;
  font-weight: 500;
  color: #b42318;
}

QLabel[role="hint"] {
  font-size: 12px;
  color: #52616b;
}

QLabel[role="hintError"] {
  font-size: 12px;
  color: #b42318;
}

/* ---------- 卡面与容器 ---------- */

QFrame[role="card"] {
  background: #ffffff;
  /* 边线退到几乎不可见（#eef1f4 与窗口底色同值）：层次交给投影和明度差，
     描边只负责在浅色屏幕上给卡片一个物理边界，不参与视觉强调。 */
  border: 1px solid #eef1f4;
  border-radius: 18px;
}

QFrame[role="tip"] {
  background: #f7f9fa;
  border: 1px solid #e8ecef;
  border-radius: 12px;
}

QFrame[role="adv"] {
  background: #f7f9fa;
  border: 1px solid #e8ecef;
  border-radius: 14px;
}

QFrame[role="brief"] {
  background: #eef8f5;
  border: 1px solid #c9e6e0;
  border-radius: 14px;
}

/* ---------- 指标与数值 ---------- */

QLabel[role="bigValue"] {
  font-size: 32px;
  font-weight: 600;
  letter-spacing: -0.8px;
}

QFrame[role="metric"] {
  background: #f7f9fa;
  border: 1px solid #e8ecef;
  border-radius: 12px;
}

QLabel[role="metricCap"] {
  font-size: 11.5px;
  font-weight: 500;
  color: #8b98a3;
}

QLabel[role="metricValue"] {
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.3px;
}

QLabel[role="metricValueTx"] {
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.3px;
  color: #9a6700;
}

QLabel[role="metricValueRx"] {
  font-size: 18px;
  font-weight: 600;
  letter-spacing: -0.3px;
  color: #116b62;
}

QLabel[role="chip"] {
  background: #f2f5f7;
  border: 1px solid #e3e8ec;
  border-radius: 999px;
  padding: 3px 10px;
  font-size: 11.5px;
  font-weight: 500;
  color: #52616b;
}

QLabel[role="diag"] {
  background: #fef6e7;
  border: 1px solid #f5e2bd;
  border-radius: 999px;
  padding: 3px 10px;
  font-size: 11.5px;
  font-weight: 500;
  color: #9a6700;
}

QFrame[role="chart"] {
  background: #ffffff;
  border: 1px solid #e8ecef;
  border-radius: 12px;
}

QLabel[role="legendRx"] {
  font-size: 11.5px;
  font-weight: 500;
  color: #116b62;
}

QLabel[role="legendTx"] {
  font-size: 11.5px;
  font-weight: 500;
  color: #9a6700;
}

QFrame[role="tile"] {
  background: #f7f9fa;
  border: 1px solid #e8ecef;
  border-radius: 14px;
}

QLabel[role="tileCap"] {
  font-size: 11.5px;
  font-weight: 500;
  color: #8b98a3;
}

QLabel[role="tileBig"] {
  font-size: 34px;
  font-weight: 600;
  letter-spacing: -1px;
}

QLabel[role="tileUnit"] {
  font-size: 12px;
  font-weight: 500;
  color: #8b98a3;
}

QLabel[role="tileSub"] {
  font-family: "Cascadia Mono", "Consolas", "JetBrains Mono", monospace;
  font-size: 11.5px;
  color: #8b98a3;
}

QLabel[role="tileSubBad"] {
  font-family: "Cascadia Mono", "Consolas", "JetBrains Mono", monospace;
  font-size: 11.5px;
  color: #b42318;
}

QLabel[role="lossValue"] {
  font-family: "Cascadia Mono", "Consolas", "JetBrains Mono", monospace;
  font-size: 16px;
  font-weight: 600;
  color: #116b62;
}

/* ---------- 输入控件 ---------- */

QLineEdit, QComboBox {
  background: #ffffff;
  border: 1px solid #dde3e8;
  border-radius: 9px;
  padding: 0 11px;
  min-height: 37px;
  font-size: 13.5px;
  selection-background-color: #0e8c80;
  selection-color: #ffffff;
}

QLineEdit:hover, QComboBox:hover {
  border-color: #c4ced6;
}

QLineEdit:focus, QComboBox:focus {
  border: 2px solid #0e8c80;
  padding: 0 10px;          /* 边框加粗 1px 时补回内边距，避免文字跳动 */
}

QLineEdit:disabled, QComboBox:disabled {
  color: #52616b;
  background: #f2f5f7;
  border-color: #e8ecef;
}

QComboBox::drop-down {
  border: none;
  width: 26px;
}

QComboBox QAbstractItemView {
  background: #ffffff;
  border: 1px solid #e3e8ec;
  border-radius: 8px;
  padding: 4px;
  selection-background-color: #e3f1ee;
  selection-color: #116b62;
  outline: none;
}

QCheckBox {
  color: #3d4a54;
  font-size: 12px;
  spacing: 8px;
}

QCheckBox::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid #c4ced6;
  border-radius: 5px;
  background: #ffffff;
}

QCheckBox::indicator:hover {
  border-color: #0e8c80;
}

QCheckBox::indicator:checked {
  background: #0e8c80;
  border-color: #0e8c80;
  image: url(:/assets/check.png);
}

/* ---------- 按钮 ---------- */

QPushButton {
  min-height: 38px;
  padding: 0 15px;
  border: 1px solid #dde3e8;
  border-radius: 9px;
  background: #ffffff;
  color: #3d4a54;
  font-size: 13px;
  font-weight: 500;
}

QPushButton:hover {
  border-color: #c4ced6;
  background: #f7f9fa;
}

QPushButton:pressed {
  background: #eef1f4;
}

QPushButton:disabled {
  color: #b3bdc6;
  border-color: #e8ecef;
  background: #f7f9fa;
}

QPushButton#primary {
  min-height: 42px;
  padding: 0 26px;
  border: none;
  border-radius: 10px;
  background: #0e8c80;
  color: #ffffff;
  font-size: 13.5px;
  font-weight: 600;
  letter-spacing: 0.2px;
}

QPushButton#primary:hover {
  background: #116b62;
}

QPushButton#primary:pressed {
  background: #0d5a53;
}

QPushButton#primary:disabled {
  background: #c9e6e0;
  color: #ffffff;
}

QPushButton#danger {
  min-height: 42px;
  padding: 0 26px;
  border: 1px solid #f3d3d0;
  border-radius: 10px;
  background: #fdf3f2;
  color: #b42318;
  font-size: 13.5px;
  font-weight: 600;
}

QPushButton#danger:hover {
  background: #fbe8e6;
  border-color: #e9bdb8;
}

QPushButton#ghost {
  min-height: 28px;
  padding: 0 11px;
  font-size: 12px;
  color: #52616b;
}

QPushButton#link {
  border: none;
  background: transparent;
  color: #52616b;
  font-size: 12.5px;
  font-weight: 500;
  text-align: left;
  padding: 5px 0;
}

QPushButton#link:hover {
  color: #0e8c80;
  background: transparent;
}

QToolButton#eye {
  border: none;
  background: transparent;
  min-width: 28px;
  min-height: 28px;
}

QToolButton#eye:hover {
  background: #f2f5f7;
  border-radius: 8px;
}

/* ---------- 日志与进度 ---------- */

QPlainTextEdit#log {
  background: #f7f9fa;
  border: 1px solid #e8ecef;
  border-radius: 12px;
  padding: 12px 14px;
  font-family: "Cascadia Mono", "Consolas", "JetBrains Mono", monospace;
  font-size: 11.8px;
  color: #3d4a54;
  selection-background-color: #c9e6e0;
  selection-color: #16212b;
}

QProgressBar {
  border: none;
  border-radius: 3px;
  background: #e8ecef;
  max-height: 6px;
  min-height: 6px;
  text-align: center;
}

QProgressBar::chunk {
  border-radius: 3px;
  background: #0e8c80;
}

/* ---------- 滚动条与提示 ---------- */

QScrollBar:vertical {
  background: transparent;
  width: 10px;
  margin: 2px;
}

QScrollBar::handle:vertical {
  background: #cfd7de;
  border-radius: 4px;
  min-height: 28px;
}

QScrollBar::handle:vertical:hover {
  background: #b3bdc6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
  height: 0;
}

QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
  background: transparent;
}

QScrollBar:horizontal {
  background: transparent;
  height: 10px;
  margin: 2px;
}

QScrollBar::handle:horizontal {
  background: #cfd7de;
  border-radius: 4px;
  min-width: 28px;
}

QScrollBar::handle:horizontal:hover {
  background: #b3bdc6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
  width: 0;
}

QToolTip {
  background: #16212b;
  color: #ffffff;
  border: none;
  border-radius: 6px;
  padding: 6px 9px;
  font-size: 12px;
}
