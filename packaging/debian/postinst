#!/bin/sh
# fcp 安装后脚本：注册 systemd unit，首次安装时生成密钥。不自动 start：
# 装好包不等于配好密钥（没有密钥时 fcp-server 会以 "--key is required …"
# 退出）。旧包的配置与旧参数拼写一律不迁移：不兼容旧版本，参数以
# `fcp-server --help` 为准。
set -e

env_file=/etc/fcp/fcp.env

if [ "$1" = "configure" ]; then
  # 新装时目录由 dpkg 建好；升级时保留已有日志/状态。
  install -d -m 0750 /etc/fcp

  # 该 conffile 里放密钥（FCP_KEY_ARGS=--key=<32 hex>），必须是 0600。
  # dpkg 升级时只解包新版本提供的文件，不会收紧既有文件的权限，所以老版本
  # 装过的机器要在这里补一次。只在文件存在时改，避免在 dpkg 尚未落地时创建
  # 出空文件。
  if [ -e "$env_file" ]; then
    chmod 0600 "$env_file" || true
  fi

  if [ -d /run/systemd/system ] && [ -x /bin/systemctl ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true
  fi

  key=""
  if [ -f "$env_file" ]; then
    key="$(grep -v '^[[:space:]]*#' "$env_file" |
      grep -oE -- '--key=[0-9a-fA-F]{32}' | head -n1 | cut -d= -f2)"

    # conffile 里还没有密钥就生成一个：没有密钥的服务起来立刻以
    # "--key is required" 退出，所以填空总是比留空好，首装和升级都一样。
    #
    # 升级时也补，是因为"空"只可能来自三种情况，都该填：① 上一版把密钥放在
    # 另一个变量/路径（0.0.10 的 /etc/fcp-node + FCP_PSK），新 conffile 落地
    # 时是空模板；② 老 conffile 被 dpkg 保留成不含密钥的版本；③ 运维清空了它
    # 却忘了填。已配置的机器不受影响——$key 非空就不会进这个分支，运维正在用
    # 的值不会被覆盖。
    generated=0
    if [ -z "$key" ]; then
      key="$(od -An -N16 -tx1 /dev/urandom | tr -d ' \n')"
      printf '%s\n' "$key" | grep -qE '^[0-9a-f]{32}$' || key=""
      if [ -n "$key" ]; then
        generated=1
        if grep -q '^FCP_KEY_ARGS=' "$env_file"; then
          # 空的 FCP_KEY_ARGS= 占位行原位替换，不重复堆行。
          sed -i "s|^FCP_KEY_ARGS=.*|FCP_KEY_ARGS=--key=$key|" "$env_file"
        else
          printf 'FCP_KEY_ARGS=--key=%s\n' "$key" >> "$env_file"
        fi
      fi
    fi

    # 升级时补了密钥要说清楚：运维本以为配置是他自己定的，静默改掉会让
    # "为什么我的密钥变了"变成一场排障。
    if [ "$generated" = "1" ] && [ -n "$2" ]; then
      cat <<EOF

注意：这次是升级（从 $2），检测到 /etc/fcp/fcp.env 里没有密钥，已自动
生成一个新的并写入：

  FCP_KEY_ARGS=--key=$key

若上一版用的是别的密钥（例如 0.0.10 的 FCP_PSK，或你另存的旧值），客户端
需要改成这个新值，或把它换成旧值后 systemctl restart fcp。

EOF
    fi
  fi

  # $2 是「之前安装的版本号」：dpkg 在首次 configure 时传空串，升级时传旧版本。
  # 只有首次安装才打印上手步骤；升级不重复刷提示。
  if [ -z "$2" ]; then
    if [ -n "$key" ]; then
      cat <<EOF

FCP 服务端已安装。密钥已就位（/etc/fcp/fcp.env，0600，root 可读）：

  FCP_KEY_ARGS=--key=$key

下一步：
  1. systemctl enable --now fcp     （密钥已就位，直接就能起）
  2. journalctl -u fcp -f

客户端用同一个 --key 即可连接。密钥以 argv 形式传给 fcp-server，本机用户
默认能从 ps/proc 看到；多用户主机请给 /proc 挂 hidepid=2。

日志：FCP_ARGS 默认 --log-level=debug，逐请求日志同时写 journald 和
/var/log/fcp/server.log（32 MiB 轮转）；要安静就改 FCP_ARGS 里的
--log-level=LEVEL（off/error/warn/info/debug）。

要更换密钥：openssl rand -hex 16，替换 fcp.env 的 FCP_KEY_ARGS 行，
systemctl restart fcp。
版本自检：fcp-server -h（第一行是版本号）

EOF
    else
      cat <<'EOF'

FCP 服务端已安装。下一步：
  1. 编辑 /etc/fcp/fcp.env，设置 FCP_KEY_ARGS=--key=HEX32
     （openssl rand -hex 16）
  2. systemctl enable --now fcp
  3. journalctl -u fcp -f

密钥以 argv 形式传给 fcp-server，本机用户默认能从 ps/proc 看到；多用户
主机请给 /proc 挂 hidepid=2。

日志：FCP_ARGS 默认 --log-level=debug，逐请求日志同时写 journald 和
/var/log/fcp/server.log（32 MiB 轮转）；要安静就改 FCP_ARGS 里的
--log-level=LEVEL（off/error/warn/info/debug）。

版本自检：fcp-server -h（第一行是版本号）
EOF
    fi
  fi
fi

exit 0
