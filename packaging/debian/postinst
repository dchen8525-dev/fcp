#!/bin/sh
# fcp-proxy 安装后脚本：注册 systemd unit，处理从无到有的首次启用。
# 不自动 start：装好包不等于配好密钥（/etc/fcp/fcp-proxy.env 默认是空的）。
set -e

if [ "$1" = "configure" ]; then
  # 新装时目录由 dpkg 建好；升级时保留已有日志/状态。
  install -d -m 0750 /etc/fcp

  # 该 conffile 里放 FCP_PSK=<PSK>（配合 FCP_ARGS 的 --key-env=FCP_PSK）
  # 或旧写法的 --key/--key-file 参数，必须是 0600。dpkg 升级时只解包新版本
  # 提供的文件，不会收紧既有文件的权限，所以老版本装过的机器要在这里补一次。
  # 只在文件存在时改，避免在 dpkg 尚未落地时创建出空文件。
  if [ -e /etc/fcp/fcp-proxy.env ]; then
    chmod 0600 /etc/fcp/fcp-proxy.env || true
  fi

  if [ -d /run/systemd/system ] && [ -x /bin/systemctl ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true
  fi

  # $2 是「之前安装的版本号」：dpkg 在首次 configure 时传空串，升级时传旧版本。
  # 只有首次安装才打印上手步骤 —— 升级的人早就配好了，每次升级再刷一遍三行
  # 提示只会让人怀疑是不是又要重配。
  if [ -z "$2" ]; then
    cat <<'EOF'

FCP proxy 已安装。下一步：
  1. 编辑 /etc/fcp/fcp-proxy.env，填写 FCP_ARGS（至少要有 --key=HEX32 或 --key-file=FILE）
  2. systemctl enable --now fcp-proxy
  3. journalctl -u fcp-proxy -f

版本自检：fcp-proxy-server --version
EOF
  fi
fi

exit 0
