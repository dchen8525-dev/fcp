{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64 (MSVC, Ninja Multi-Config)",
      "description": "build.bat loads vcvars64.bat first, so cl.exe is on PATH.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64-app",
      "displayName": "Windows x64 + Qt client (vcpkg toolchain)",
      "inherits": "windows-x64",
      "binaryDir": "${sourceDir}/build/windows-x64-app",
      "cacheVariables": {
        "FCP_BUILD_APP": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64 (Ninja, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release"
    },
    {
      "name": "windows-x64-app-debug",
      "configurePreset": "windows-x64-app",
      "configuration": "Debug"
    },
    {
      "name": "windows-x64-app-release",
      "configurePreset": "windows-x64-app",
      "configuration": "Release"
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-x64-debug",
      "configurePreset": "windows-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    }
  ]
}
