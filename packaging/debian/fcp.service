[Unit]
Description=FCP server (UDP tunnel endpoint with FEC)
Documentation=file:///usr/share/doc/fcp-server/部署运维指南.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# 一个只做 UDP 中继和本地 TCP 出站拨号的服务不需要任何特权身份。DynamicUser
# 让 systemd 每次启动分配一个无特权用户，并把下面 LogsDirectory/StateDirectory
# 建给它 —— 下面那段"目录归服务用户所有"的说明在此之前并不成立，因为没配
# User= 时服务是以 root 跑的，目录自然归 root。
# 代价：默认 UDP 端口 4460 无需特权端口，若运维把它改到 1024 以下会启动失败。
DynamicUser=yes
# 参数全部来自 /etc/fcp/fcp.env（包内的 conffile）。密钥只有一种写法：
# 在 FCP_KEY_ARGS 里写 `--key=HEX32`（postinst 首次安装会自动生成）。
# 密钥因此出现在进程 argv 里：root 和本机用户默认能从 /proc/<pid>/cmdline
# 读到。DynamicUser 限制了服务权限，但隐藏不了 argv；多用户主机应给 /proc
# 挂 hidepid=2，或只在受信任的主机上部署。
# 未配置密钥时服务会以 "--key is required …" 退出，这是有意的：装了包不等于
# 配好了密钥，见 部署运维指南.md §3/§4。
EnvironmentFile=-/etc/fcp/fcp.env
ExecStart=/usr/bin/fcp-server $FCP_KEY_ARGS $FCP_ARGS
Restart=on-failure
RestartSec=3

# trace 与日志目录由 systemd 创建并归服务用户所有：
#   LogsDirectory   -> /var/log/fcp   （--metrics 前缀与默认
#                       --log-file=/var/log/fcp/server.log 都写这里）
#   StateDirectory  -> /var/lib/fcp
LogsDirectory=fcp
LogsDirectoryMode=0750
StateDirectory=fcp
StateDirectoryMode=0750

# 每连接最坏 2 × --window MAX 内存（部署运维指南.md §5.1）：自适应默认
# 1024 KiB × 256 会话 ≈ 512 MiB，再加上 FEC/流缓冲。这里刻意不设 MemoryMax
# （默认即无限制）——真正的内存上限由 --max-sessions 和 --window MAX 决定，
# 写 MemoryMax=infinity 只是重复默认值，看不出任何意图。
LimitNOFILE=65536

# 服务端只需要 UDP 出站与本地 TCP 出站拨号，不需要任何特权。
# AF_NETLINK 是 getifaddrs() 的依赖：--mtu 自动取值要枚举本机接口，裸的
# AF_INET/AF_INET6 白名单会让 socket(NETLINK_ROUTE) 返回 EAFNOSUPPORT，默认
# 静默退化成不按接口下调（文档承诺的行为只在手工运行时成立）。
# AF_UNIX 留给 NSS（nss-resolve 等）解析目标主机名，否则某些主机上 DNS 会失败。
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
