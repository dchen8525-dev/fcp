#!/bin/sh
# fcp 安装后脚本：注册 systemd unit，处理从无到有的首次启用。
# 不自动 start：装好包不等于配好密钥（/etc/fcp/fcp.env 默认是空的）。
set -e

if [ "$1" = "configure" ]; then
  # 新装时目录由 dpkg 建好；升级时保留已有日志/状态。
  install -d -m 0750 /etc/fcp

  # 该 conffile 里放 FCP_PSK=<PSK>（配合 FCP_ARGS 的 --key-env=FCP_PSK）
  # 或旧写法的 --key/--key-file 参数，必须是 0600。dpkg 升级时只解包新版本
  # 提供的文件，不会收紧既有文件的权限，所以老版本装过的机器要在这里补一次。
  # 只在文件存在时改，避免在 dpkg 尚未落地时创建出空文件。
  if [ -e /etc/fcp/fcp.env ]; then
    chmod 0600 /etc/fcp/fcp.env || true
  fi

  if [ -d /run/systemd/system ] && [ -x /bin/systemctl ]; then
    systemctl --system daemon-reload >/dev/null 2>&1 || true
  fi

  # $2 是「之前安装的版本号」：dpkg 在首次 configure 时传空串，升级时传旧版本。
  # 只有首次安装才打印上手步骤 —— 升级的人早就配好了，每次升级再刷一遍三行
  # 提示只会让人怀疑是不是又要重配。
  if [ -z "$2" ]; then
    cat <<'EOF'

FCP 服务端已安装。下一步：
  1. 编辑 /etc/fcp/fcp.env，设置 FCP_PSK=HEX32（openssl rand -hex 16）与
     FCP_ARGS=--key-env=FCP_PSK —— 本 unit 是 DynamicUser，服务用户读不了
     root 的 0600 文件，--key-file 在 systemd 下不工作；--key=HEX32 会把
     PSK 暴露在 ps 的 argv 里，也不要用（fcp.env 顶部注释是权威说明）
  2. systemctl enable --now fcp
  3. journalctl -u fcp -f

版本自检：fcp-server --version
EOF
  fi
fi

exit 0
